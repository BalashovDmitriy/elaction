; Файл конфигурации движка.
; Обычно правится через UI редактора Godot, но базовые решения зафиксированы
; здесь осознанно — см. docs/adr/0002-visual-target.md.

config_version=5

[application]

config/name="elaction"
config/description="Ремейк аркадной игры Elevator Action (Taito, 1983) на Godot 4."
config/version="0.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

; Базовый вьюпорт 640x360 — ровно 1/3 от 1080p, даёт целочисленный скейл 3x.
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194319), Object(InputEventKey,"device":-1,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194321), Object(InputEventKey,"device":-1,"physical_keycode":68)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194320), Object(InputEventKey,"device":-1,"physical_keycode":87)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194322), Object(InputEventKey,"device":-1,"physical_keycode":83)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventKey,"device":-1,"physical_keycode":90)]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":88), Object(InputEventKey,"device":-1,"physical_keycode":74)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305)]
}

[rendering]

renderer/rendering_method="forward_plus"
; Пиксель-арт: без сглаживания при масштабировании.
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_2d=0
