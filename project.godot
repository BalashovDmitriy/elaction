; Файл конфигурации движка.
; Обычно правится через UI редактора Godot, но базовые решения зафиксированы
; здесь осознанно — см. docs/adr/0019-3d-pivot.md и docs/adr/0021-3d-greybox.md.
; ADR-0002 (HD пиксель-арт) отменён: сцена стала трёхмерной.

config_version=5

[application]

config/name="elaction"
config/description="Ремейк аркадной игры Elevator Action (Taito, 1983) на Godot 4."
config/version="0.9.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

; Базовый вьюпорт 1920x1080 (ADR-0018 в части разрешения остаётся в силе).
; Мир больше не измеряется в пикселях: с M15 он метрический, 100 прежних
; пикселей = 1 м (ADR-0019, решение 3). Растяжение canvas_items оставлено —
; оно теперь обслуживает только HUD и меню, 3D рисуется в разрешении окна.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[autoload]

Screenshotter="*res://src/autoload/screenshotter.gd"
; Имя автолоада отличается от class_name скрипта (GameState) намеренно: Godot
; не даёт глобальному классу и автолоаду называться одинаково, а код обращается
; к состоянию через GameState.instance().
Game="*res://src/autoload/game_state.gd"
; Звук: один автолоад на всю игру, чтобы источники не плодились по сценам.
Sound="*res://src/autoload/audio.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

; Клавиатура использует physical_keycode: клавиши остаются на своих физических
; местах и на кириллической раскладке. Геймпад — раскладка Xbox. С M24c на
; игровое действие одна клавиша и одна кнопка — игрок переназначает их в меню,
; схема в user://settings.cfg (KeyBindings, ADR-0039, решение 7).
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194319), Object(InputEventJoypadButton,"device":-1,"button_index":13), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194321), Object(InputEventJoypadButton,"device":-1,"button_index":14), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194320), Object(InputEventJoypadButton,"device":-1,"button_index":11), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194322), Object(InputEventJoypadButton,"device":-1,"button_index":12), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":88), Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}
screenshot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194343)]
}

[layer_names]

; Слой 1 — геометрия здания и кабины, слой 2 — Otto, слой 3 — враги. Маски в сценах
; и в коде заданы числами; имена нужны, чтобы в инспекторе было видно, что выбрано.
; Otto, враги и лампы разведены по слоям, чтобы пуля знала, во что ей можно
; попасть, а зоны удара не находили посторонних: лампа на слое врагов заставляла
; и удар ногой, и её собственную зону разбирать чужаков.
; С M15 те же четыре слоя живут в 3D-физике; 2D-имена оставлены до M20, пока
; из проекта не вычищены последние 2D-системы (ADR-0021, решение 6).
2d_physics/layer_1="geometry"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="lamps"
3d_physics/layer_1="geometry"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="lamps"

[rendering]

renderer/rendering_method="forward_plus"
; Пиксельная привязка и фильтр ближайшего соседа убраны вместе с ADR-0002:
; сцена трёхмерная, привязывать к пикселю нечего, а nearest на 3D-текстурах
; даёт только грязь. Настройки объёмного света, SSR и грейдинга сюда не
; добавляются — они выбираются на готовой сцене в M17, а не вслепую.
anti_aliasing/quality/msaa_2d=0
; Дизеринг против полос на градиентах тумана и неба (ADR-0030, решение 4).
; Сглаживание 3D и атлас теней ставит Graphics по уровню качества (ADR-0034).
anti_aliasing/quality/use_debanding=true

[audio]

buses/default_bus_layout="res://assets/audio/buses.tres"

[internationalization]

; Переводы собираются из assets/i18n/ui.csv: одна таблица, две колонки.
locale/translations=PackedStringArray("res://assets/i18n/ui.en.translation", "res://assets/i18n/ui.ru.translation")
locale/fallback="en"

[debug]

; Правило 1 CLAUDE.md — типы везде. У gdlint такого правила нет, поэтому
; нетипизированное объявление — ошибка разбора: его ловит godot_check.py и CI.
; Вендоренный addons/ не задет — движок по умолчанию пропускает его предупреждения.
gdscript/warnings/untyped_declaration=2
