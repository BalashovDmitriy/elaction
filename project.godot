; Engine configuration file.
; Usually edited through the Godot editor UI, but the basic decisions are fixed
; here deliberately — see docs/adr/0019-3d-pivot.md and docs/adr/0021-3d-greybox.md.
; ADR-0002 (HD pixel art) is superseded: the scene became three-dimensional.

config_version=5

[application]

config/name="elaction"
config/description="A remake of the arcade game Elevator Action (Taito, 1983) in Godot 4."
config/version="0.9.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

; Base viewport 1920x1080 (ADR-0018 stays in force regarding resolution).
; The world is no longer measured in pixels: since M15 it is metric, 100 former
; pixels = 1 m (ADR-0019, decision 3). canvas_items stretching is kept —
; it now serves only the HUD and menu, 3D is drawn at window resolution.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[autoload]

Screenshotter="*res://src/autoload/screenshotter.gd"
; The autoload name differs from the script's class_name (GameState) on purpose: Godot
; does not allow a global class and an autoload to have the same name, and the code accesses
; the state through GameState.instance().
Game="*res://src/autoload/game_state.gd"
; Sound: one autoload for the whole game, so that sources do not multiply across scenes.
Sound="*res://src/autoload/audio.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

; The keyboard uses physical_keycode: keys stay in their physical
; places on a Cyrillic layout too. Gamepad — Xbox layout. Since M24c each
; game action has one key and one button — the player rebinds them in the menu,
; the scheme is in user://settings.cfg (KeyBindings, ADR-0039, decision 7).
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194319), Object(InputEventJoypadButton,"device":-1,"button_index":13), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194321), Object(InputEventJoypadButton,"device":-1,"button_index":14), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194320), Object(InputEventJoypadButton,"device":-1,"button_index":11), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194322), Object(InputEventJoypadButton,"device":-1,"button_index":12), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":88), Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}
screenshot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194343)]
}

[layer_names]

; Layer 1 — building and cab geometry, layer 2 — Otto, layer 3 — enemies. Masks in scenes
; and in code are set by numbers; names are needed so the inspector shows what is selected.
; Otto, enemies and lamps are split across layers so that a bullet knows what it may
; hit, and hit zones do not find outsiders: a lamp on the enemy layer made
; both the kick and its own zone sort through strangers.
; Layer 5 — corpses (ADR-0043, decision 10): they lie on each other, the living do not see them.
; Since M15 the same four layers live in 3D physics; 2D names are kept until M20, until
; the last 2D systems are cleaned out of the project (ADR-0021, decision 6).
2d_physics/layer_1="geometry"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="lamps"
3d_physics/layer_1="geometry"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="lamps"
3d_physics/layer_5="corpses"

[rendering]

renderer/rendering_method="forward_plus"
; Pixel snapping and nearest-neighbour filtering were removed together with ADR-0002:
; the scene is three-dimensional, there is nothing to snap to a pixel, and nearest on 3D textures
; only gives dirt. Volumetric light, SSR and grading settings are not added
; here — they are chosen on the finished scene in M17, not blindly.
anti_aliasing/quality/msaa_2d=0
; Dithering against banding in fog and sky gradients (ADR-0030, decision 4).
; 3D antialiasing and the shadow atlas are set by Graphics per quality level (ADR-0034).
anti_aliasing/quality/use_debanding=true

[audio]

buses/default_bus_layout="res://assets/audio/buses.tres"

[internationalization]

; Translations are built from assets/i18n/ui.csv: one table, two columns.
locale/translations=PackedStringArray("res://assets/i18n/ui.en.translation", "res://assets/i18n/ui.ru.translation")
locale/fallback="en"

[debug]

; Rule 1 of CLAUDE.md — types everywhere. gdlint has no such rule, so
; an untyped declaration is a parse error: godot_check.py and CI catch it.
; The vendored addons/ is not affected — the engine skips its warnings by default.
gdscript/warnings/untyped_declaration=2

[physics]

; Jolt, not the built-in engine: on corpse ragdolls that one pushed parts through
; the slab and did not put them to sleep (ADR-0043, decision 13). The shape rounding margin is zero:
; with it characters stood on the floor a centimetre higher.
3d/physics_engine="Jolt Physics"
jolt_physics_3d/collisions/collision_margin_fraction=0.0
