; Файл конфигурации движка.
; Обычно правится через UI редактора Godot, но базовые решения зафиксированы
; здесь осознанно — см. docs/adr/0002-visual-target.md.

config_version=5

[application]

config/name="elaction"
config/description="Ремейк аркадной игры Elevator Action (Taito, 1983) на Godot 4."
config/version="0.9.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

; Базовый вьюпорт 640x360 — ровно 1/3 от 1080p, даёт целочисленный скейл 3x.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[autoload]

Screenshotter="*res://src/autoload/screenshotter.gd"
; Имя автолоада отличается от class_name скрипта (GameState) намеренно: Godot
; не даёт глобальному классу и автолоаду называться одинаково, а код обращается
; к состоянию через GameState.instance().
Game="*res://src/autoload/game_state.gd"
; Звук: один автолоад на всю игру, чтобы источники не плодились по сценам.
Sound="*res://src/autoload/audio.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

; Клавиатура использует physical_keycode: WASD остаются на своих физических
; местах и на кириллической раскладке. Геймпад — раскладка Xbox.
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194319), Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventJoypadButton,"device":-1,"button_index":13), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194321), Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventJoypadButton,"device":-1,"button_index":14), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194320), Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventJoypadButton,"device":-1,"button_index":11), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194322), Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventJoypadButton,"device":-1,"button_index":12), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventKey,"device":-1,"physical_keycode":90), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
shoot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":88), Object(InputEventKey,"device":-1,"physical_keycode":74), Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82)]
}
quit_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81)]
}
screenshot={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194343)]
}

[layer_names]

; Слой 1 — геометрия здания и кабины, слой 2 — Otto, слой 3 — враги. Маски в сценах
; и в коде заданы числами; имена нужны, чтобы в инспекторе было видно, что выбрано.
; Otto, враги и лампы разведены по слоям, чтобы пуля знала, во что ей можно
; попасть, а зоны удара не находили посторонних: лампа на слое врагов заставляла
; и удар ногой, и её собственную зону разбирать чужаков.
2d_physics/layer_1="geometry"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="lamps"

[rendering]

renderer/rendering_method="forward_plus"
; Пиксель-арт: без сглаживания при масштабировании.
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_2d=0

[audio]

buses/default_bus_layout="res://assets/audio/buses.tres"

[internationalization]

; Переводы собираются из assets/i18n/ui.csv: одна таблица, две колонки.
locale/translations=PackedStringArray("res://assets/i18n/ui.en.translation", "res://assets/i18n/ui.ru.translation")
locale/fallback="en"
