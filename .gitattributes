# One line ending across the repository: LF everywhere, including the working copy
# on Windows. Godot and CI handle LF the same way, and diffs stay quiet.
* text=auto eol=lf

*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.cfg     text eol=lf
*.import  text eol=lf
*.md      text eol=lf
*.yml     text eol=lf

# Binary assets
*.png    binary
*.jpg    binary
*.webp   binary
*.ogg    binary
*.wav    binary
*.ttf    binary
*.otf    binary
*.blend  binary
*.glb    binary
