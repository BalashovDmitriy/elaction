class_name WorldSpace
extends RefCounted

## Перевод между плоскостью правил и трёхмерной сценой.
##
## Правила считают Y вниз: [method BuildingRules.floor_surface] растёт с номером
## этажа, нулевой этаж — верхний. Так было в 2D, и менять это нельзя — слой правил
## при переезде не трогается (ADR-0019, решение 2).
##
## Сцена считает Y вверх, как весь остальной Godot: туда смотрят источники света,
## туда же по умолчанию направлен [constant Vector3.UP] у [CharacterBody3D].
## Разворачивать одно под другое пришлось бы в каждом узле, и знак разъехался бы
## на первой же правке.
##
## Поэтому перевод живёт здесь и только здесь. Узел берёт у правил [Vector2],
## отдаёт сцене [Vector3] — и обратно. Если понадобилось перевернуть Y где-то
## ещё, значит правило залезло в представление (ADR-0021, решение 2).

## Глубина коридора, в котором идёт игра, м.
##
## Всё игровое стоит в плоскости Z = 0; коридор — это объём вокруг неё, стены
## которого видно в кадре. Неглубокий нарочно: глубина берётся комнатой за
## задней стеной, а не разносом игровых объектов (ADR-0021, решение 1).
const CORRIDOR_DEPTH: float = 2.0

## Глубина комнаты за задней стеной коридора, м. Число из пробы `look3d.gd`.
##
## Эта комната не игровая: в неё не зайти, она видна в проёмы дверей и в окна и
## даёт кадру глубину, туман и дальний план.
const ROOM_DEPTH: float = 7.0

## Плоскость игры по Z. Ноль, и это не совпадение: всё игровое обязано лежать
## в одной плоскости, иначе «дотянулся или нет» становится свойством расстановки
## мешей, а не правил.
const PLAY_Z: float = 0.0

## Где стоит задняя стена коридора. Коридор симметричен вокруг плоскости игры,
## поэтому стена — на половине его глубины за ней. На этой стене висят двери,
## окна и створки шахт; всё, что за ней, — комната, в которую не зайти.
const BACK_WALL_Z: float = -CORRIDOR_DEPTH * 0.5

## Толщина игровых тел по Z, м: актёров, ламп, кабины. Одна на всех, чтобы
## тени и коллизии сходились в одной и той же плоскости, а не каждая в своей.
const BODY_DEPTH: float = 0.4


## Точка плоскости правил → точка сцены.
static func to_scene(point: Vector2) -> Vector3:
	return Vector3(point.x, -point.y, PLAY_Z)


## Точка сцены → точка плоскости правил. Z отбрасывается: игра плоская.
static func to_plane(point: Vector3) -> Vector2:
	return Vector2(point.x, -point.y)


## Высота правил → высота сцены. Отдельно от точки: этажи и потолки приходят
## одним числом, и заворачивать их в [Vector2] ради перевода незачем.
static func height_to_scene(y: float) -> float:
	return -y


## Высота сцены → высота правил.
static func height_to_plane(y: float) -> float:
	return -y


## Вектор скорости или смещения плоскости → вектор сцены.
##
## Отдельно от [method to_scene] намеренно, хотя формула та же: точка и вектор
## разойдутся, как только у сцены появится смещение по Z, и разбирать это в
## одной функции будет поздно.
static func direction_to_scene(delta: Vector2) -> Vector3:
	return Vector3(delta.x, -delta.y, 0.0)


## Вектор сцены → вектор плоскости.
static func direction_to_plane(delta: Vector3) -> Vector2:
	return Vector2(delta.x, -delta.y)
