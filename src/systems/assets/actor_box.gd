class_name ActorBox
extends MeshInstance3D

## Тело актёра в греев-боксе: коробка, меняющая габарит с позой.
##
## Модели придут в M16 и встанут на это же место в сцене. До тех пор единственное,
## чем актёр показывает состояние, — форма: присевший ниже, мёртвый лежит.
## Позу выбирает [ActorPose], как в 2D выбирал спрайт; узел только исполняет.
##
## Один на Otto и на агента: у них разные размеры, но одно и то же правило
## «как коробка отыгрывает позу», и написанное дважды оно разошлось бы на
## первой же правке.

## Габарит стоя и в приседе, м. Отдаёт тот, кто знает форму коллизии, —
## актёр в [method Node._ready]: записанный здесь вторым числом размер
## разошёлся бы с телом, которым актёр на самом деле ловит пули.
var standing := Vector3.ONE
var crouching := Vector3.ONE

var _shown := ""
var _mesh := BoxMesh.new()


func _ready() -> void:
	mesh = _mesh


## Собирает коробку под позу. Пересобирает только на смене: [BoxMesh]
## пересчитывает вершины на каждую запись размера, а поз за секунду меняются
## единицы, кадров же — шестьдесят.
func show_pose(pose: String) -> void:
	if pose == _shown:
		return
	_shown = pose

	var size := standing
	if pose == ActorPose.CROUCH:
		size = crouching
	elif ActorPose.is_down(pose):
		# Лежащий занимает столько же, сколько стоял, но поперёк.
		size = Vector3(standing.y, standing.x, standing.z)
	_mesh.size = size
	# Начало актёра — в ногах, начало коробки — в её середине.
	position = Vector3(0.0, size.y * 0.5, 0.0)


## Куда актёр смотрит: -1 влево, +1 вправо. Зеркалить нечего, пока нет модели,
## поэтому поворот показан разворотом коробки.
func face(direction: float) -> void:
	rotation.y = 0.0 if direction >= 0.0 else PI
