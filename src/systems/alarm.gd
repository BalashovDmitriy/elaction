class_name Alarm
extends RefCounted

## Тревога по таймеру.
##
## Провозился со зданием — включается сирена: агенты злеют, кабина отвечает
## с задержкой. Смерть тревогу не снимает, сбрасывает её только смена здания
## (ADR-0009, пункт 1) — то есть это наказание на всё прохождение, а не на попытку.
##
## Момент срабатывания оригиналом не подтверждён, поэтому вынесен в параметр.

## Сколько времени даётся на здание, с.
##
## Пять минут — **временное значение до живой игры**, поставленное 2026-09-22
## (ADR-0009, пункт 5). Это не измеренный баланс: число подбирается вживую и
## будет уточнено, когда по зданию пройдёт человек, а не бот.
##
## Прежние сто секунд поставили до M18a, и раскладка вехи их обесценила: чистый
## проход без боя стоит 89–113 с (замер `tools/playthrough.gd` на пяти сидах),
## то есть сирена успевала включиться до конца безупречной партии на четырёх
## сидах из пяти — и включала задержку кабин ровно там, где маршрут теперь
## состоит из пересадок. Запас взят с избытком намеренно: игра и так усложнилась
## вехой, и на время замеров лишнее давление только путает картину.
##
## Цена запаса известна: при пяти минутах сирена в обычной партии не включается
## вовсе, и наказания за отсидку не остаётся, пока у приседа нет цены
## (открытый вопрос №7, веха M16a).
var time_limit: float = 300.0

var raised: bool = false

var _left: float = 0.0


## Новое здание: тревога снимается и отсчёт начинается заново. Единственный
## способ её снять — смерть игрока этого не делает.
func enter_building() -> void:
	raised = false
	_left = time_limit


## Отсчитывает время. Возвращает true в тот единственный кадр, когда тревога
## включилась, чтобы по ней можно было разово поднять всех на уши.
func tick(delta: float) -> bool:
	if raised:
		return false

	_left -= delta
	if _left > 0.0:
		return false

	raised = true
	return true


## Сколько осталось до тревоги, с. После срабатывания — ноль.
func time_left() -> float:
	return maxf(_left, 0.0)
