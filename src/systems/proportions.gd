class_name Proportions
extends RefCounted

## Размеры всего, что стоит в здании, — одной таблицей в пикселях оригинала.
##
## До M18c метры жили там, где их брали: рост — в сцене актёра и в
## `tools/build_actors.py`, дверь — в [Door], лампа — в своей сцене, пули —
## в экспортах, допуски — в боте. Двадцать чисел в десятке файлов расходились
## молча: сдвинешь одно, соседнее, от него зависящее, остаётся прежним. Решение
## пользователя (2026-09-23): размеры задаются здесь, остальные их выводят
## ([ADR-0026](../../docs/adr/0026-proportions.md), решение 8).
##
## Единица — пиксель кадра оригинала (аркада, 256×224), а не метр: так каждое
## число сверяется с кадром напрямую. В метры пиксель переводит [constant PX]:
## шаг этажа 48 px — это 3.6 м нашего здания.
##
## Здесь — **размеры**, а не зазоры между ними и не скорости. На том, что пуля
## проходит над коленом, а из прыжка не достаёт лампы, держится игра, и
## стерегут это тесты отношениями ([code]test_proportions.gd[/code]). Скорости и
## дальности — числа баланса, им место в [BuildingRules].
##
## Своя таблица замеров оригинала лежит в тесте отдельно от этой: иначе тест
## сверял бы таблицу саму с собой.

## Метров в пикселе оригинала: шаг этажа 3.6 м на 48 px.
const PX: float = 0.075

## Этаж: шаг и плита. Просвет между ними — 40 px, 3.0 м.
const FLOOR: float = 48.0 * PX
const SLAB: float = 8.0 * PX
const CLEARANCE: float = FLOOR - SLAB

## Шаг места на этаже и ширина шахты: 24 px, шахта ровно в шаг.
const SLOT: float = 24.0 * PX
const SHAFT: float = 24.0 * PX

## Высота кадра: поле здания оригинала, 176 px — 3.67 этажа.
const FIELD: float = 176.0 * PX

## Тело — одно на Otto и агента: в оригинале они одного роста, 22–23 px над
## полом. Ширина 9.6 px против 10 у оригинала: так тело ложится ровно в 0.72 м,
## от которых отмерены проём эскалатора и допуски бота.
const BODY: float = 22.4 * PX
const BODY_WIDTH: float = 9.6 * PX

## Присевший Otto: 64% роста, как 15–16 px из 24 спрайта оригинала.
const CROUCH: float = 14.4 * PX

## Агент на колене и лёжа. Колено — присед агента в оригинале, ~14 px над полом;
## лёжа — треть роста.
const KNEEL: float = 13.5 * PX
const PRONE: float = 7.0 * PX

## Пуля Otto стоя — 15 px над полом, как на кадре оригинала: грудь, чуть выше
## присевшего агента. Из приседа — над полями шляпы лежащего агента.
const SHOT_HIGH: float = 15.0 * PX
const SHOT_LOW: float = 8.8 * PX

## Пуля агента — пять шестых роста: берёт стоящего, проходит над присевшим и над
## тем, кто стоит ниже этажа в кабине, вставшей между этажами.
const AGENT_SHOT: float = BODY * 5.0 / 6.0

## Вынос ствола вперёд от середины тела и ширина зоны удара ногой.
const MUZZLE: float = 7.0 * PX
const KICK_WIDTH: float = 16.0 * PX

## Створка двери: 16×28 px, верх в 12 px от потолка. Коврик — две трети створки.
const DOOR := Vector2(16.0 * PX, 28.0 * PX)
const DOOR_MAT: float = DOOR.x * 2.0 / 3.0

## Лампа: 8×6 px под самым потолком, на шнуре в полпикселя. Низ выходит на 84%
## просвета против 82% у оригинала — это запас, на котором держится «лампу не
## сбить из прыжка» (ADR-0026, решение 5).
const LAMP := Vector2(8.0 * PX, 6.0 * PX)
const LAMP_CORD: float = 0.4 * PX

## Проём выхода: не шире места без кабины соседней шахты, 22.4 px.
const EXIT_WIDTH: float = 22.4 * PX

## Номер этажа: табличка 12×7 px в 1.4 px от стены и потолка, цифра 5 px.
const FLOOR_SIGN := Vector2(12.0 * PX, 7.0 * PX)
const FLOOR_SIGN_GAP: float = 1.4 * PX
const FLOOR_DIGIT: float = 5.0 * PX

## Машина у выхода, длина: в неё садится Otto, и она в 1.9 его роста.
const CAR_LENGTH: float = BODY * 1.905


## Задаёт форме-коробке габарит и, если [param grounded], ставит её низом на ноль
## узла: у [CollisionShape3D] начало в середине, и одна лишь смена размера
## утопила бы тело в пол.
##
## Подресурс формы общий на все копии сцены, и правится он на месте: число одно
## на всех, и повторная правка ничего не меняет. Тот, кому нужна своя форма —
## агент, приседающий независимо от соседей, — копирует её сам.
static func fit_box(shape: CollisionShape3D, size: Vector3, grounded: bool = true) -> void:
	(shape.shape as BoxShape3D).size = size
	if grounded:
		shape.position.y = size.y * 0.5


## То же для видимой коробки.
static func fit_mesh(visual: MeshInstance3D, size: Vector3) -> void:
	(visual.mesh as BoxMesh).size = size
