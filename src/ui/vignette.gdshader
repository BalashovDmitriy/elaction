shader_type canvas_item;

// Виньетка: затемнение к углам кадра.
//
// Нужна не для красоты, а чтобы взгляд держался на середине экрана. Камера
// показывает два с половиной этажа, и без затемнения края кадра — верхний и
// нижний этажи — спорят за внимание с тем, где стоит Otto.
//
// Затемнение, а не размытие: размытие в пиксель-арте съедает сетку, на которую
// в ADR-0002 всё и поставлено.

uniform float strength : hint_range(0.0, 1.0) = 0.55;

// Докуда кадр остаётся нетронутым, в долях полудиагонали.
uniform float clear_part : hint_range(0.0, 1.0) = 0.45;

uniform vec3 tint : source_color = vec3(0.01, 0.01, 0.05);

void fragment() {
	// Кадр шире, чем выше, и по кругу затемнение легло бы по бокам сильнее,
	// чем сверху. Считаем в долях от середины к краю по каждой оси отдельно.
	vec2 from_centre = abs(UV - vec2(0.5)) * 2.0;
	float reach = length(from_centre) / sqrt(2.0);
	COLOR = vec4(tint, smoothstep(clear_part, 1.0, reach) * strength);
}
