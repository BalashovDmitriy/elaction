root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript: официальный стиль — табы, как и требует gdformat
[*.gd]
indent_style = tab
indent_size = 4
max_line_length = 100

# Файлы, которые генерирует сам Godot — не трогаем форматированием
[*.{tscn,tres,godot,import}]
indent_style = tab
trim_trailing_whitespace = false
insert_final_newline = false

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2
