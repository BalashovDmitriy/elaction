root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript: the official style — tabs, as gdformat requires
[*.gd]
indent_style = tab
indent_size = 4
max_line_length = 100

# Files Godot generates itself — not touched by formatting
[*.{tscn,tres,godot,import}]
indent_style = tab
trim_trailing_whitespace = false
insert_final_newline = false

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2
